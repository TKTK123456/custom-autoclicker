{
  "name": "custom-autoclicker",
  "version": "1.0.1",
  "description": "Custom autoclicker",
  "homepage": "https://github.com/TKTK123456/custom-autoclicker#readme",
  "bugs": {
    "url": "https://github.com/TKTK123456/custom-autoclicker/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TKTK123456/custom-autoclicker.git"
  },
  "license": "MIT",
  "author": "TKTK1234567",
  "type": "module",
  "main": "./build/backend/main.js",
  "scripts": {
    "buildTS": "tsx build.ts",
    "startForge": "npm run buildTS && electron-forge start",
    "start": "npm run buildTS && electron .",
    "format": "prettier --plugin=prettier-plugin-ejs --write 'src/**/*.{ts,tsx,js,jsx,ejs,html}'",
    "check": "tsc --noEmit",
    "test": "echo \"Error: no test specified\" && exit 1",
    "package": "electron-forge package",
    "make": "npm run buildTS && electron-forge make"
  },
  "dependencies": {
    "@types/ejs": "^3.1.5",
    "ejs": "^6.0.1",
    "electron-squirrel-startup": "^1.0.1",
    "robotjs": "^0.9.1",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@types/node": "^26.2.0",
    "electron": "^43.4.0",
    "eslint-plugin-prettier": "^5.5.3",
    "prettier": "^3.9.6",
    "prettier-plugin-ejs": "^1.0.3",
    "tsx": "^4.23.12",
    "typescript": "^5.0.0"
  },
  "allowScripts": {
    "uiohook-napi@1.5.5": true,
    "robotjs@0.9.1": true
  }
}
